# Geisha Gains - Environment Variables Template
# Coffee Driven Development - BugsByte 2026
#
# ⚠️  SECURITY WARNING:
# Never commit real API keys or credentials to version control!
# Copy this file to .env and fill in your actual values.
# The .env file is automatically ignored by .gitignore.

# ============================================
# DATABASE
# ============================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/geisha_gains"

# For testing with SQLite (no PostgreSQL needed)
# DATABASE_URL="file:./dev.db"

# ============================================
# NVIDIA NIM API
# ============================================

# NVIDIA NIM API endpoint for Llama-3
# Get your API key from: https://build.nvidia.com/
NVIDIA_NIM_ENDPOINT="https://integrate.api.nvidia.com/v1/chat/completions"
NVIDIA_API_KEY="nvapi-your-actual-api-key-here"

# Optional: Model selection
# NVIDIA_MODEL="meta/llama-3-70b-instruct"

# ============================================
# UPHOLD API (Optional)
# ============================================

# Uphold API is public and doesn't require auth for ticker data
# But you can add credentials if using authenticated endpoints
# UPHOLD_API_KEY="your-uphold-api-key"

# ============================================
# APPLICATION SETTINGS
# ============================================

# Next.js environment
NODE_ENV="development"

# Application URL (for production)
# NEXT_PUBLIC_APP_URL="https://geisha-gains.vercel.app"

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features for testing
# ENABLE_REAL_TRADING="false"
# ENABLE_OVERDRIVE="true"
# MOCK_NVIDIA_NIM="false"
